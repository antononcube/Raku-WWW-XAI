use v6.d;
use Test;
use WWW::XAI;

my $has-key = %*ENV<XAI_API_KEY>:exists;

if $has-key {
    plan 2;

    my $answer = xai-console(
        path => 'models',
        format => 'values',
        :!echo
    );

    #say (:$answer);
    ok $answer ~~ Str && $answer.chars, 'chat returns assistant text';
    is $answer.contains('grok-4.5'), True, 'response contains the requested expected model';
} else {
    plan 1;
    skip 'Set XAI_API_KEY to run live xAI chat tests', 1;
}
